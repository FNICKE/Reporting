
# Allow CORS for all origins (Apache level)
Header always set Access-Control-Allow-Origin "https://reporting.sainikshetkari.org"
Header always set Access-Control-Allow-Credentials "true"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, Accept, Origin, X-Requested-With"

# Handle OPTIONS preflight at Apache level - return 200 immediately
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]
